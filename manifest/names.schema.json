{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cairn-proofs/oscal-bindings-specs/manifest/names.schema.json",
  "title": "OSCAL naming manifest, format 1",
  "description": "The canonical type names of one OSCAL release. See openspec/specs/naming-manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "oscal-release", "schema", "types"],
  "properties": {
    "format": { "const": 1 },
    "oscal-release": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "types": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "pointer": { "type": "string", "pattern": "^#(/([A-Za-z0-9:._-]|~[01])*)*$" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/pointer" }
    },
    "entry": {
      "type": "object",
      "required": ["name", "kind", "sites"],
      "properties": {
        "kind": { "enum": ["object", "document", "document-union", "union", "enum", "single-or-many"] }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "sites"],
          "properties": {
            "name": { "$ref": "#/definitions/name" },
            "kind": { "const": "object" },
            "sites": { "$ref": "#/definitions/sites" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "sites", "body-field"],
          "properties": {
            "name": { "$ref": "#/definitions/name" },
            "kind": { "const": "document" },
            "sites": { "$ref": "#/definitions/sites" },
            "body-field": { "$ref": "#/definitions/key" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "sites", "members"],
          "properties": {
            "name": { "$ref": "#/definitions/name" },
            "kind": { "const": "document-union" },
            "sites": { "$ref": "#/definitions/sites" },
            "members": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/name" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "sites", "variants"],
          "properties": {
            "name": { "$ref": "#/definitions/name" },
            "kind": { "const": "union" },
            "sites": { "$ref": "#/definitions/sites" },
            "variants": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "property"],
                "properties": {
                  "type": { "$ref": "#/definitions/name" },
                  "property": { "$ref": "#/definitions/key" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "sites", "closed"],
          "properties": {
            "name": { "$ref": "#/definitions/name" },
            "kind": { "const": "enum" },
            "sites": { "$ref": "#/definitions/sites" },
            "closed": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "sites", "item"],
          "properties": {
            "name": { "$ref": "#/definitions/name" },
            "kind": { "const": "single-or-many" },
            "sites": { "$ref": "#/definitions/sites" },
            "item": { "$ref": "#/definitions/name" }
          }
        }
      ]
    }
  }
}
