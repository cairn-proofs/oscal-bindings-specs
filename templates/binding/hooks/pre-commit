#!/bin/sh
# Pre-commit hook of an OSCAL binding, from templates/binding/ of the OSCAL bindings spec store.
#
# It verifies the pinned spec artifact by its sha256, extracts it to a temporary directory, and runs the binding
# checker of that artifact and `openspec validate --all --strict` on the staged files. It stops at the first failure.
#
# Set the three variables below when you install the hook, and set the first two again on each pin move. A path that
# is not absolute is relative to the root of the repository. Each variable also reads an environment variable.
ARCHIVE="${OSCAL_SPECS_ARCHIVE:-}"                              # the pinned spec artifact, a .tar.gz file
ARCHIVE_SHA256="${OSCAL_SPECS_SHA256:-}"                        # the pinned sha256 of that file
RECORD="${OSCAL_SPECS_RECORD:-openspec/traceability.json}"      # the traceability record of the binding

set -eu

fail() {
  echo "pre-commit: $*" >&2
  exit 1
}

[ -n "$ARCHIVE" ] || fail "set ARCHIVE at the top of the hook to the path of the pinned spec artifact."
[ -n "$ARCHIVE_SHA256" ] || fail "set ARCHIVE_SHA256 at the top of the hook to the pinned sha256 of the artifact."
command -v node >/dev/null 2>&1 || fail "node is not on the PATH."
command -v openspec >/dev/null 2>&1 || fail "openspec is not on the PATH."

top=$(git rev-parse --show-toplevel)
case $ARCHIVE in /*) ;; *) ARCHIVE="$top/$ARCHIVE" ;; esac
[ -f "$ARCHIVE" ] || fail "the archive $ARCHIVE does not exist."

if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$ARCHIVE" | cut -d ' ' -f 1)
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$ARCHIVE" | cut -d ' ' -f 1)
else
  fail "there is no sha256sum and no shasum to verify the archive."
fi
[ "$actual" = "$ARCHIVE_SHA256" ] || fail "the sha256 of $ARCHIVE is $actual, not the pinned $ARCHIVE_SHA256."

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
mkdir "$work/store" "$work/staged"

tar -xzf "$ARCHIVE" -C "$work/store"
set -- "$work"/store/*/
[ $# -eq 1 ] && [ -d "$1" ] || fail "the archive $ARCHIVE does not hold one top directory."
store=${1%/}
checker="$store/templates/binding/bin/check-binding.mjs"
[ -f "$checker" ] || fail "the archive $ARCHIVE holds no binding checker."

# Check the staged files, not the working tree. The checker reads the base ref through GIT_DIR.
git checkout-index --all --prefix="$work/staged/"
GIT_DIR=$(cd "$(git rev-parse --git-dir)" && pwd)
export GIT_DIR
cd "$work/staged"

node "$checker" --store "$store" --record "$RECORD"
openspec validate --all --strict
